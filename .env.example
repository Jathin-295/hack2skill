# Optional: enables real Gemini text and image analysis. Keep this key server-side.
GEMINI_API_KEY=
# Optional model override. Default: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
# Optional HTTP port. Default: 8790
PORT=8790
# Optional Postgres connection URL for durable cloud storage. Use a Neon
# Marketplace integration on Vercel; local development can keep using JSON.
DATABASE_URL=
# Required to enable report status changes from the local admin workspace.
# Set your own private value in .env. Never use this example value for deployment.
ADMIN_TOKEN=replace-with-a-private-local-token
# Optional category-to-team overrides as a JSON object.
TEAM_MAPPING_JSON={"Roads":"Roads & Highways","Waste":"Solid Waste Management","Water":"Water Supply","Drainage":"Stormwater & Drainage","Streetlights":"Electrical Maintenance","Public infrastructure":"Public Works","Other":"Civic Response"}
